APP_NAME="Caldas Gestão"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# White-label branding (production values belong in the deployment secret store).
# BRAND_NAME=
# BRAND_LOGO_URL=
# BRAND_FAVICON_URL=
# BRAND_PRIMARY_COLOR=
# BRAND_ACCENT_COLOR=

# Lastlink SaaS billing. Configure the webhook URL in Lastlink as:
# https://your-domain.example/webhooks/lastlink
# LASTLINK_WEBHOOK_SECRET=
# LASTLINK_CHECKOUT_URL=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Optional secret used by app:bootstrap-tenant in controlled deployments.
# Leave empty to force a hidden interactive prompt. Never use a default
# password in production.
BOOTSTRAP_TENANT_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development and CI use SQLite, so a fresh clone does not need a
# database server or credentials. The database file is created by setup.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_URL=
# DB_SCHEMA=app
# DB_SEARCH_PATH=app,public
# DB_RUNTIME_ROLE=caldas_runtime
# DB_PROVISION_STRICT=true

# Production override (Supabase PostgreSQL). Set these through the deployment
# secret store; never commit credentials to this file or to the repository.
# DB_CONNECTION=pgsql
# DB_HOST=your-project.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project
# DB_PASSWORD=
# DB_SSLMODE=require
#
# Direct endpoint used only by schema provisioning and migrations. Runtime may
# continue to use the Supabase session pooler through the DB_* variables above.
# MIGRATION_DB_CONNECTION=pgsql
# MIGRATION_DATABASE_URL=
# MIGRATION_DB_HOST=db.your-project.supabase.co
# MIGRATION_DB_PORT=5432
# MIGRATION_DB_DATABASE=postgres
# MIGRATION_DB_USERNAME=postgres
# MIGRATION_DB_PASSWORD=
# MIGRATION_DB_SSLMODE=require

# Local drivers do not require Redis. Override these together in production.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MEDIA_DISK=public
QUEUE_CONNECTION=sync
# OUTBOX_CONSUMER=local.inbox

CACHE_STORE=file
CACHE_PREFIX=caldas-gestao

MEMCACHED_HOST=127.0.0.1

# Optional production Redis override. Keep credentials in deployment secrets.
REDIS_CLIENT=phpredis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Premium custom domains
DOMAINS_EXPECTED_CNAME=vps.caldasindica.com
DOMAINS_OFFICIAL_HOSTS=gestao.caldasindica.com
DOMAINS_SSL_TIMEOUT=8

# Coolify provisioning (keep the token only in the deployment secret store)
COOLIFY_BASE_URL=https://cy.caldasindica.com
COOLIFY_APPLICATION_UUID=svurav3cvfovuz8adtv1fuwv
COOLIFY_API_KEY=
