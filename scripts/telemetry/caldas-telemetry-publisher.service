[Unit]
Description=Publish prepared telemetry incident patches as draft pull requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/caldas-telemetry/publisher.py
TimeoutStartSec=180s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caldas-telemetry
Environment=PYTHONDONTWRITEBYTECODE=1
