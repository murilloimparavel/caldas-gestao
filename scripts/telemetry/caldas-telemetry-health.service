[Unit]
Description=Report typed Caldas telemetry health independently of Codex and incident jobs
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
StateDirectory=caldas-telemetry
StateDirectoryMode=0700
ExecStart=/usr/bin/python3 /opt/caldas-telemetry/health.py --state-dir /var/lib/caldas-telemetry
TimeoutStartSec=100s
KillMode=control-group
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/caldas-telemetry -/run/docker.sock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=PYTHONDONTWRITEBYTECODE=1
StandardOutput=journal
StandardError=journal
